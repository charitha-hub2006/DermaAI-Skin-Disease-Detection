{% extends "base.html" %}

{% block content %}
<section class="dashboard">
    <div class="welcome">
        <p class="eyebrow">YOUR PERSONAL SPACE</p>
        <h1>Welcome, {{ user.name }}!</h1>
        <p>Keep track of your skin-health journey, one step at a time.</p>
    </div>

    {% with messages = get_flashed_messages(with_categories=true) %}
        {% for category, message in messages %}
            <div class="flash-message">{{ message }}</div>
        {% endfor %}
    {% endwith %}

    <div class="dashboard-grid">
        <article class="dashboard-card">
            <span class="card-icon">✦</span>
            <h2>Skin analysis</h2>
            <p>Upload a skin image to explore an experimental CNN classification.</p>
            <a class="action-link" href="{{ url_for('predict_page') }}">
                Start an analysis →
            </a>
        </article>

        <article class="dashboard-card">
            <span class="card-icon">♡</span>
            <h2>Skin-health guides</h2>
            <p>Learn general information about skin conditions and prevention.</p>
            <a class="action-link" href="{{ url_for('about') }}">
                Explore information →
            </a>
        </article>

        <article class="dashboard-card">
            <span class="card-icon">◎</span>
            <h2>Your account</h2>
            <p><strong>Name:</strong> {{ user.name }}</p>
            <p><strong>Email:</strong> {{ user.email }}</p>
            <p class="small-note">Your account was created for your personal use.</p>
        </article>
    </div>

    <div class="notice">
        <strong>A gentle reminder</strong>
        <p>
            DermaAI provides experimental image classifications, not medical
            diagnoses. Consult a qualified healthcare professional about
            concerning or changing skin symptoms.
        </p>
    </div>

    <form method="POST" action="{{ url_for('auth.logout') }}">
        <button class="logout-button" type="submit">Log out</button>
    </form>
</section>

<style>
.dashboard {
    max-width: 1050px;
    margin: 45px auto;
    padding: 20px;
}
.welcome { margin-bottom: 32px; }
.welcome h1 { margin: 8px 0; }
.eyebrow {
    color: #547a68;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
}
.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 20px;
    margin: 25px 0;
}
.dashboard-card {
    padding: 25px;
    border: 1px solid #e2e8e2;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.04);
}
.card-icon { font-size: 28px; color: #547a68; }
.dashboard-card h2 { font-size: 20px; margin: 15px 0 10px; }
.dashboard-card p { line-height: 1.6; }
.action-link { color: #426b58; font-weight: 600; }
.small-note { font-size: 13px; color: #68736c; }
.notice {
    padding: 20px;
    border-radius: 12px;
    background: #f1f5ef;
    line-height: 1.6;
}
.notice p { margin-bottom: 0; }
.logout-button {
    margin-top: 22px;
    padding: 11px 20px;
    border: 1px solid #c9d5cc;
    border-radius: 9px;
    background: white;
    cursor: pointer;
}
.flash-message {
    margin: 12px 0;
    padding: 10px;
    border-radius: 8px;
    background: #f3f5ef;
}
</style>
{% endblock %}
