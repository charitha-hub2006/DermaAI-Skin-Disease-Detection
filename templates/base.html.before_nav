
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{% block title %}DermaAI | Your Skin, Better Understood{% endblock %}</title>
  <meta name="theme-color" content="#f8f8f4">
  <meta name="description" content="Explore skin insights with DermaAI. Upload a skin image to receive an AI-generated skin classification.">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">

  <style>
    :root {
      --derma-bg: #f8f8f4;
      --derma-surface: #ffffff;
      --derma-green: #315b49;
      --derma-green-dark: #244536;
      --derma-soft: #eaf0e8;
      --derma-text: #26352d;
      --derma-muted: #788078;
      --derma-border: #e8e9e2;
      --derma-radius: 20px;
    }

    body {
      background: var(--derma-bg);
      color: var(--derma-text);
      font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI",
                   sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .navbar {
      background: rgba(255, 255, 255, 0.94);
      border-bottom: 1px solid var(--derma-border);
      padding: 16px 0;
      backdrop-filter: blur(14px);
    }

    .navbar-brand {
      color: var(--derma-text) !important;
      font-size: 1.4rem;
      font-weight: 750;
      letter-spacing: -0.8px;
    }

    .brand-mark {
      width: 38px;
      height: 38px;
      border-radius: 13px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--derma-soft);
      color: var(--derma-green);
      margin-right: 8px;
    }

    .navbar .nav-link {
      color: #626b63;
      font-size: 0.94rem;
      font-weight: 550;
      padding: 10px 14px !important;
      border-radius: 12px;
    }

    .navbar .nav-link:hover,
    .navbar .nav-link.active {
      color: var(--derma-green);
      background: var(--derma-soft);
    }

    .btn-derma {
      background: var(--derma-green);
      border: 1px solid var(--derma-green);
      border-radius: 999px;
      color: white;
      font-weight: 600;
      padding: 11px 21px;
      transition: background .2s ease, transform .2s ease;
    }

    .btn-derma:hover {
      background: var(--derma-green-dark);
      border-color: var(--derma-green-dark);
      color: white;
      transform: translateY(-1px);
    }

    .btn-derma-outline {
      border: 1px solid #cfd8cf;
      color: var(--derma-green);
      background: white;
      border-radius: 999px;
      font-weight: 600;
      padding: 10px 19px;
    }

    .btn-derma-outline:hover {
      background: var(--derma-soft);
      color: var(--derma-green-dark);
    }

    main {
      width: 100%;
      flex: 1;
    }

    .disclaimer-banner {
      background: #f0f1e9;
      color: #5b6257;
      border: 1px solid #e5e7dc;
      border-radius: 12px;
      padding: 11px 15px;
      font-size: 0.8rem;
      line-height: 1.55;
    }

    .disclaimer-banner i {
      color: var(--derma-green);
    }

    .alert {
      border-radius: 14px;
      border: 0;
    }

    footer {
      background: white;
      border-top: 1px solid var(--derma-border);
      margin-top: 56px;
      padding: 25px 0;
      color: var(--derma-muted);
      font-size: 0.85rem;
    }

    footer a {
      color: var(--derma-green);
      text-decoration: none;
    }

    @media (max-width: 991px) {
      .navbar .nav-link {
        margin-top: 4px;
      }

      .navbar .nav-cta {
        margin: 10px 0 4px;
        display: inline-block;
      }
    }
  </style>

  {% block extra_head %}{% endblock %}
</head>

<body>
  <nav class="navbar navbar-expand-lg sticky-top">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center"
         href="{{ url_for('index') }}">
        <span class="brand-mark">
          <i class="bi bi-flower1 fs-5"></i>
        </span>
        DermaAI
      </a>

      <button class="navbar-toggler" type="button"
              data-bs-toggle="collapse"
              data-bs-target="#navbarContent"
              aria-controls="navbarContent"
              aria-expanded="false"
              aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarContent">
        <ul class="navbar-nav ms-auto align-items-lg-center mt-3 mt-lg-0">
          <li class="nav-item">
            <a class="nav-link {% if request.endpoint == 'index' %}active{% endif %}"
               href="{{ url_for('index') }}">
              Home
            </a>
          </li>

          <li class="nav-item">
            <a class="nav-link {% if request.endpoint == 'predict_page' %}active{% endif %}"
               href="{{ url_for('predict_page') }}">
              Skin analysis
            </a>
          </li>

          <li class="nav-item ms-lg-2">
            <a class="btn btn-derma nav-cta"
               href="{{ url_for('predict_page') }}">
              Get started <i class="bi bi-arrow-up-right ms-1"></i>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  {% with messages = get_flashed_messages(with_categories=true) %}
    {% if messages %}
      <div class="container mt-3">
        {% for category, message in messages %}
          <div class="alert alert-{{ category if category != 'error' else 'danger' }} alert-dismissible fade show"
               role="alert">
            {{ message }}
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  {% endwith %}

  <main class="container py-4 py-md-5">
    {% block content %}{% endblock %}
  </main>

  <footer>
    <div class="container d-flex flex-column flex-md-row
                justify-content-between align-items-md-center gap-3">
      <div>
        <a href="{{ url_for('index') }}"
           class="fw-bold fs-5">DermaAI</a>
        <div class="mt-1">A little more insight into your skin.</div>
      </div>

      <div class="small">
        AI-generated skin insights are not a medical diagnosis.
        For skin concerns, consult a qualified dermatologist.
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="{{ url_for('static', filename='js/main.js') }}"></script>
  {% block extra_js %}{% endblock %}
</body>
</html>
